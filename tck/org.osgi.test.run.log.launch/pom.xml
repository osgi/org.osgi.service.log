<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.osgi.tck</groupId>
		<artifactId>org.osgi.tck.service.log</artifactId>
		<version>${revision}</version>
	</parent>
	<groupId>org.osgi.tck</groupId>
	<artifactId>org.osgi.test.run.log.launch</artifactId>

	<properties>
		<!-- The keystore of the secure suites, as an absolute path. The test VM
		     runs from a working directory below target/, so a path relative to
		     this module would not resolve there; the workspace build likewise
		     hands the framework an absolute path. -->
		<tck.keystore>${project.basedir}/../keystore</tck.keystore>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.osgi.tck</groupId>
			<artifactId>org.osgi.test.cases.log.launch</artifactId>
			<version>${revision}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.framework</artifactId>
			<version>${org.osgi.framework.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.resource</artifactId>
			<version>${org.osgi.resource.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.felix</groupId>
			<artifactId>org.apache.felix.configadmin</artifactId>
			<version>${org.apache.felix.configadmin.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.cm</artifactId>
			<version>1.6.0</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.osgi</artifactId>
			<version>${org.eclipse.osgi.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!--
			The test infrastructure, at the versions of the parent pom.
			It is declared as a real dependency because the bnd resolver only
			sees what is in the Maven tree — listing it in the bndrun alone is
			not enough.
		-->
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-commons</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-engine</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.test.common</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.test.assertj.framework</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.test.junit5</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				The launch suite does not need a hosting OSGi framework: every test
				starts its own framework from the class path. It runs as plain
				JUnit 5 tests with Surefire, taken from the test cases jar, with
				the same system properties the bndrun used to pass.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<dependenciesToScan>
						<dependency>org.osgi.tck:org.osgi.test.cases.log.launch</dependency>
					</dependenciesToScan>
					<!-- LaunchTest builds the class loader of the launched framework
					     from java.class.path, so the full class path must be there. -->
					<useManifestOnlyJar>false</useManifestOnlyJar>
					<useModulePath>false</useModulePath>
					<argLine>-Djava.security.manager=allow</argLine>
					<systemPropertyVariables>
						<org.osgi.test.cases.log.launch.storageroot>${project.build.directory}/org.osgi.test.cases.log.launch.testStorageRoot</org.osgi.test.cases.log.launch.storageroot>
						<org.osgi.test.cases.log.launch.bundles></org.osgi.test.cases.log.launch.bundles>
					</systemPropertyVariables>
					<reportsDirectory>${project.build.directory}/test-reports/tck</reportsDirectory>
				</configuration>
			</plugin>
			<!-- Renders the JUnit XML into a readable HTML report:
			     mvn surefire-report:report-only -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<configuration>
					<reportsDirectories>
						<reportsDirectory>${project.build.directory}/test-reports/tck</reportsDirectory>
					</reportsDirectories>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
